# ==========================================
# MAX API Configuration
# ==========================================
MAX_API_URL=https://api.max.messenger.com
MAX_BOT_TOKEN=your_bot_token_here
MAX_WEBHOOK_SECRET=your_webhook_secret_here
MAX_WEBHOOK_URL=https://yourdomain.com/api/webhook/max

# ==========================================
# Database Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mikhalych_bot
DB_USER=bot_user
DB_PASSWORD=secure_database_password
DB_SSL_MODE=prefer
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password
REDIS_DB=0
REDIS_SSL=false

# ==========================================
# External APIs - HR System
# ==========================================
HR_SYSTEM_API_URL=https://hr.onlanta.com/api
HR_SYSTEM_API_VERSION=v2
HR_SYSTEM_API_KEY=your_hr_api_key_here
HR_SYSTEM_TIMEOUT=15

# ==========================================
# External APIs - 1C ZUP
# ==========================================
1C_API_URL=https://1c.onlanta.com/api
1C_API_VERSION=v1
1C_API_USER=api_user
1C_API_PASSWORD=your_1c_password_here
1C_API_TIMEOUT=20

# ==========================================
# Security Settings
# ==========================================
SECRET_KEY=your_secret_key_for_sessions_min_32_chars
ENCRYPTION_KEY=your_encryption_key_for_passwords_min_32_chars
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# Session settings
SESSION_LIFETIME_HOURS=8
SESSION_MAX_INACTIVE_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=60

# Password encryption
PASSWORD_ENCRYPTION_ALGORITHM=AES-256-CBC
SALT_ROUNDS=12

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_FILE=/var/log/mikhalych_bot/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_MB=100

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=30
RATE_LIMIT_MAX_REQUESTS_PER_HOUR=500
RATE_LIMIT_BLOCK_DURATION_MINUTES=15

# ==========================================
# Pagination Settings
# ==========================================
PAGINATION_RESOURCES_PER_PAGE=5
PAGINATION_EMPLOYEES_PER_PAGE=10
PAGINATION_CONTRACTORS_PER_PAGE=10

# ==========================================
# Feature Flags
# ==========================================
FEATURE_EMPLOYEE_SEARCH=true
FEATURE_COMPANY_RESOURCES=true
FEATURE_SIB_HELP=false
FEATURE_VACATION_INFO=true
FEATURE_TRAINING_UPLOAD=false
FEATURE_PING_PONG=false
FEATURE_WIFI_PASSWORD=true
FEATURE_MANAGER_SECTION=true
FEATURE_CONTRACTOR_REPORT=true

# ==========================================
# Monitoring & Metrics
# ==========================================
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# Sentry (Error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==========================================
# Application Settings
# ==========================================
APP_NAME=Mikhаlych Bot
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
TESTING=false

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# CORS settings
CORS_ENABLED=true
CORS_ORIGINS=https://yourdomain.com,https://intranet.onlanta.com

# ==========================================
# Backup & Maintenance
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/mikhalych_bot

# ==========================================
# Email Notifications (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bot@onlanta.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Mikhаlych Bot <bot@onlanta.com>
SMTP_USE_TLS=true

# Support emails
SUPPORT_EMAIL=support@onlanta.com
DEV_EMAIL=dev@onlanta.com
SECURITY_EMAIL=sib@onlanta.com

# ==========================================
# Timezone & Locale
# ==========================================
TIMEZONE=Europe/Moscow
LOCALE=ru_RU
DATE_FORMAT=%d.%m.%Y
TIME_FORMAT=%H:%M:%S
DATETIME_FORMAT=%d.%m.%Y %H:%M:%S

# ==========================================
# Cache Settings
# ==========================================
CACHE_ENABLED=true
CACHE_DEFAULT_TIMEOUT=300
CACHE_EMPLOYEE_TIMEOUT=3600
CACHE_RESOURCE_TIMEOUT=1800
CACHE_WIFI_TIMEOUT=86400

# ==========================================
# Audit Settings
# ==========================================
AUDIT_ENABLED=true
AUDIT_LOG_WIFI_ACCESS=true
AUDIT_LOG_EMPLOYEE_SEARCH=true
AUDIT_LOG_CONTRACTOR_REPORTS=true
AUDIT_RETENTION_DAYS=365

# ==========================================
# Performance Settings
# ==========================================
DB_QUERY_TIMEOUT=10
API_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=60

# Connection pool settings
DB_CONNECTION_POOL_MIN=5
DB_CONNECTION_POOL_MAX=20
REDIS_CONNECTION_POOL_MAX=50

# ==========================================
# Development Settings (not for production)
# ==========================================
# DEV_MODE=false
# MOCK_EXTERNAL_APIS=false
# ENABLE_DEBUG_TOOLBAR=false
# SQL_ECHO=false

# ==========================================
# Testing Settings (not for production)
# ==========================================
# TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_mikhalych_bot
# TEST_REDIS_URL=redis://localhost:6379/1
# TEST_MODE=false
