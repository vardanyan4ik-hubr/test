# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_assyst_bot
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# Assyst Configuration
ASSYST_INBOX_EMAIL=assyst.inbox@onlanta.ru
ASSYST_WEBHOOK_SECRET=your_webhook_secret

# Apex API Configuration
APEX_API_URL=https://apex.example.com/api
APEX_API_KEY=your_apex_api_key

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
WEBHOOK_URL=https://your-domain.com/itsm-bot/webhook

# Security
SECRET_KEY=your_secret_key_here
VERIFICATION_CODE_LENGTH=4
VERIFICATION_CODE_EXPIRY_MINUTES=5
MAX_CODE_ATTEMPTS=3

# Rate Limiting
MAX_TICKETS_PER_HOUR=5
MAX_TICKETS_PER_DAY=10
MIN_TICKET_INTERVAL_MINUTES=15

# File Upload
MAX_FILE_SIZE_MB=10
MAX_FILES_COUNT=10
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
