  "validation_rules": {
    "lastname": {
      "min_length": 2,
      "max_length": 50,
      "pattern": "^[А-Яа-яA-Za-z\\s\\-]+$",
      "error_message": "Фамилия должна содержать от 2 до 50 символов и состоять только из букв, пробелов и дефисов"
    },
    "inn_legal": {
      "length": 10,
      "pattern": "^\\d{10}$",
      "error_message": "ИНН юридического лица должен содержать 10 цифр"
    },
    "inn_individual": {
      "length": 12,
      "pattern": "^\\d{12}$",
      "error_message": "ИНН физического лица должен содержать 12 цифр"
    }
  },
  "messages": {
    "welcome_message": "👋 Привет, Я — *MAX-версия Михалыча*. Корпоративный чат-бот компании Онланта.\n\n🔐 Для начала работы мне нужно вас авторизовать.\n\n✅ Нажмите кнопку «Начать», чтобы продолжить.",
    "main_menu_message": "🏠 *Главное меню*\n\nВыберите нужный раздел:",
    "search_employee_prompt": "🔍 *Поиск сотрудников*\n\nВведите фамилию сотрудника для поиска:",
    "resources_page_title": "📚 *Ресурсы компании*\n\nСтраница {page} из {total}",
    "vacation_info_message": "🌴 *Информация об отпусках*\n\nВсего у тебя 28 календарных дней отпуска в году (если ты их не отгуляешь, они переносятся на следующий год).\n\nОдна часть твоего отпуска должна составлять 14 календарных дней единовременно.\n\n*Чтобы пойти в отпуск тебе нужно:*\n\n1️⃣ Предварительно согласовать даты отпуска с руководителем, чтобы не было пересечений с другими коллегами.\n\n2️⃣ Завести заявку на Интранете в разделе \"Отпуска и отсутствия\". Не позднее, чем за 6 рабочих дней ты должен получить согласование руководителя.\n\n3️⃣ Жди отпускные не позднее, чем за 3 дня до отпуска.",
    "access_denied_manager": "⛔ *Доступ ограничен*\n\nЭтот раздел доступен только руководителям.",
    "access_denied_general": "⛔ *Доступ ограничен*\n\nУ вас нет прав для выполнения этого действия.",
    "error_validation": "❌ *Ошибка ввода*\n\n{error_details}\n\nПопробуйте снова.",
    "error_not_found": "❌ *Не найдено*\n\nНе удалось найти информацию по вашему запросу.\n\nПроверьте правильность введенных данных.",
    "error_internal": "⚠️ *Временная ошибка*\n\nНе удалось выполнить запрос. Попробуйте снова через несколько минут.\n\nЕсли проблема сохраняется, обратитесь в техподдержку.",
    "module_unavailable": "⏸️ Этот раздел временно недоступен и находится в разработке."
  },
