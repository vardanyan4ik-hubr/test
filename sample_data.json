  "test_scenarios": {
    "auth_flow": {
      "description": "Тестовый сценарий авторизации",
      "steps": [
        {
          "step": 1,
          "action": "user_sends_start",
          "command": "/start",
          "expected_response": "welcome_message",
          "expected_buttons": ["Начать"]
        },
        {
          "step": 2,
          "action": "user_clicks_start_button",
          "callback_data": "auth_start",
          "expected_response": "auth_success",
          "expected_next_state": "MAIN_MENU"
        }
      ]
    },
    "search_employee": {
      "description": "Тестовый сценарий поиска сотрудника",
      "steps": [
        {
          "step": 1,
          "action": "user_clicks_search_employees",
          "callback_data": "menu_search_employees",
          "expected_response": "search_employee_prompt",
          "expected_state": "SEARCH_EMPLOYEE_INPUT"
        },
        {
          "step": 2,
          "action": "user_enters_lastname",
          "text": "Иванов",
          "expected_response": "employee_details",
          "expected_data": {
            "full_name": "Иванов Иван Иванович",
            "department": "IT-департамент"
          }
        }
      ]
    },
    "view_resources": {
      "description": "Тестовый сценарий просмотра ресурсов",
      "steps": [
        {
          "step": 1,
          "action": "user_clicks_resources",
          "callback_data": "menu_company_resources",
          "expected_response": "resources_page_1",
          "expected_buttons": ["Следующая ➡️", "🏠 Главное меню"]
        },
        {
          "step": 2,
          "action": "user_clicks_next_page",
          "callback_data": "resources_page_2",
          "expected_response": "resources_page_2",
          "expected_buttons": ["⬅️ Предыдущая", "Следующая ➡️", "🏠 Главное меню"]
        }
      ]
    }
  }
